            fullBio: "Allah tidak membebani seseorang melainkan sesuai dengan kesanggupannya.",
            instagram: "https://www.instagram.com/muhammad_syaugie?utm_source=qr&igsh=MTJxa2x3aHZrODQ4eQ==", linkedin: "https://www.linkedin.com/in/muhammad-syaugie-242023315", email: "azkamaulidaaca@gmail.com"
        },
        { 
            name: "Haikal Devin Prayata", role: "Cyber Security", avatarIcon: "🛡️", 
            bio: "Ethical hacking & reporting celah keamanan infrastruktur.",
            fullBio: "jangan mengeluh kalau Tuhan tidak memberi hidup yang kamu inginkan, karena kamu juga hidup tidak seperti yang Tuhan inginkan.",
            instagram: "https://www.instagram.com/devinhp5?igsh=MWhqdG5ubDh3cml6YQ==", linkedin: "https://www.linkedin.com/in/haikal-devin-prayata-6ab57532b/", email: "mk.haikaldevin@dimigi.co.id"
        },
        { 
            name: "Tirta Bimoseno Wibowo", role: "Cyber Security", avatarIcon: "🛡️", 
            bio: "Ethical hacking & reporting celah keamanan infrastruktur.",
            fullBio: "Hari ini adalah hari yang baik untuk mencoba.",
            instagram: "https://www.instagram.com/dmmmooo/", linkedin: "https://www.linkedin.com/in/tirta-bimoseno-wibowo-a241a5382/", email: "mk.bimoseno@dimigi.co.id"
        },
        { 
            name: "Eko Dimas Prasetyo", role: "SOC", avatarIcon: "🛡️", 
            bio: "Analis event log, incident response, threat hunting.",
            fullBio: "Ingat ada harapan keluarga yang harus kamu gapai.",
            instagram: "https://www.instagram.com/dzy.eko?igsh=cGJ0aTU2Z3VuN2Fp", linkedin: "https://www.linkedin.com/in/eko-dimas-prasetyo-81a240342?utm_source=share_via&utm_content=profile&utm_medium=member_android", email: "ekodimasprasetyo3@gmail.com"
        },
        { 
            name: "Waly Alfathah", role: "SOC", avatarIcon: "🛡️", 
            bio: "Analis event log, incident response, threat hunting.",
            fullBio: "Percaya Dengan Rencana Tuhan.",
            instagram: "https://www.instagram.com/wallyaft/", linkedin: "https://www.linkedin.com/in/waly-al-fathah-b9b780327/?skipRedirect=true", email: "walyalfathah@gmail.com"
        }
    ];

    const galleryItems = [
        { title: "Rack Server & Switch Config", desc: "Setup awal perangkat keras untuk simulasi jaringan.", imgUrl: "https://res.cloudinary.com/dl2dlszsr/image/upload/v1777521781/download_wy1wxs.webp" },
        { title: "Firewall Rules Workshop", desc: "Implementasi aturan firewall dan monitoring.", imgUrl: "https://res.cloudinary.com/dl2dlszsr/image/upload/v1777523343/69a04b91d1ecf95ea92e67fd_Cisco_logo_blue_2016.svg_txbiae.png" },
        { title: "Forensic & Audit", desc: "Diskusi analisis log dan forensik jaringan.", imgUrl: "https://picsum.photos/id/26/400/280" },
        { title: "Penetration Testing Lab", desc: "Simulasi serangan & hardening sistem.", imgUrl: "https://picsum.photos/id/91/400/280" },
        { title: "Security Awareness", desc: "Pelatihan untuk staff tentang cyber hygiene.", imgUrl: "https://picsum.photos/id/169/400/280" },
        { title: "Project Closure", desc: "Penyerahan sertifikat dan apresiasi.", imgUrl: "https://picsum.photos/id/77/400/280" },
        { title: "Team Collaboration", desc: "Malam finalisasi laporan & dokumentasi.", imgUrl: "https://picsum.photos/id/106/400/280" }
    ];

    const monthlyLogs = [
        { monthPeriod: "Des 2025", title: "Network Infrastructure, Security & Virtualization", descContent: "Pengenalan infrastruktur, tool security.", tags: ["ENSP", "VMware","Cisco"], detailed: "Mengelola keamanan, virtualisasi, dan sistem jaringan terintegrasi.", image: "https://picsum.photos/id/20/500/300" },
        { monthPeriod: "Jan 2026", title: "Network Infrastructure, Security & Virtualization", descContent: "Pengenalan infrastruktur, tool security.", tags: ["ENSP", "VMware","Cisco"], detailed: "Mengelola keamanan, virtualisasi, dan sistem jaringan terintegrasi.", image: "https://picsum.photos/id/48/500/300" },
        { monthPeriod: "Feb 2026", title: "Network Infrastructure, Security & Virtualization", descContent: "Pengenalan infrastruktur, tool security.", tags: ["ENSP", "VMware","Cisco"], detailed: "Mengelola keamanan, virtualisasi, dan sistem jaringan terintegrasi.", image: "https://picsum.photos/id/0/500/300" },
        { monthPeriod: "Mar 2026", title: "Network Infrastructure, Security & Virtualization", descContent: "Pengenalan infrastruktur, tool security.", tags: ["ENSP", "VMware","Cisco"], detailed: "Mengelola keamanan, virtualisasi, dan sistem jaringan terintegrasi.", image: "https://picsum.photos/id/91/500/300" },
        { monthPeriod: "Apr 2026", title: "Network Infrastructure, Security & Virtualization", descContent: "Pengenalan infrastruktur, tool security.", tags: ["ENSP", "VMware","Cisco"], detailed: "Mengelola keamanan, virtualisasi, dan sistem jaringan terintegrasi.", image: "https://picsum.photos/id/26/500/300" },
        { monthPeriod: "Mei 2026", title: "Network Infrastructure, Security & Virtualization", descContent: "Pengenalan infrastruktur, tool security.", tags: ["ENSP", "VMware","Cisco"], detailed: "Mengelola keamanan, virtualisasi, dan sistem jaringan terintegrasi.", image: "https://picsum.photos/id/169/500/300" },
        { monthPeriod: "Jun 2026", title: "Network Infrastructure, Security & Virtualization", descContent: "Pengenalan infrastruktur, tool security.", tags: ["ENSP", "VMware","Cisco"], detailed: "Mengelola keamanan, virtualisasi, dan sistem jaringan terintegrasi.", image: "https://picsum.photos/id/106/500/300" },
        { monthPeriod: "Jul 2026", title: "Network Infrastructure, Security & Virtualization", descContent: "Pengenalan infrastruktur, tool security.", tags: ["ENSP", "VMware","Cisco"], detailed: "Mengelola keamanan, virtualisasi, dan sistem jaringan terintegrasi.", image: "https://picsum.photos/id/2/500/300" },
        { monthPeriod: "Agu 2026", title: "Network Infrastructure, Security & Virtualization", descContent: "Pengenalan infrastruktur, tool security.", tags: ["ENSP", "VMware","Cisco"], detailed: "Mengelola keamanan, virtualisasi, dan sistem jaringan terintegrasi.", image: "https://picsum.photos/id/77/500/300" },
        { monthPeriod: "Sep 2026", title: "Network Infrastructure, Security & Virtualization", descContent: "Pengenalan infrastruktur, tool security.", tags: ["ENSP", "VMware","Cisco"], detailed: "Mengelola keamanan, virtualisasi, dan sistem jaringan terintegrasi.", image: "https://picsum.photos/id/30/500/300" },
        { monthPeriod: "Okt 2026", title: "Network Infrastructure, Security & Virtualization", descContent: "Pengenalan infrastruktur, tool security.", tags: ["ENSP", "VMware","Cisco"], detailed: "Mengelola keamanan, virtualisasi, dan sistem jaringan terintegrasi.", image: "https://picsum.photos/id/155/500/300" }
    ];

    function renderTeam() {
        const container = document.getElementById('teamContainer');
        if (container) {
            container.innerHTML = teamMembers.map((m, idx) => `
                <div class="team-card" data-team-index="${idx}">
                    <div class="avatar">${m.avatarIcon}</div>
                    <h3>${m.name}</h3>
                    <div class="role"><i class="fas fa-terminal"></i> ${m.role}</div>
                    <p class="bio">${m.bio}</p>
                </div>
            `).join('');
        }
        document.querySelectorAll('.team-card').forEach(card => {
            card.addEventListener('click', () => {
                const idx = card.getAttribute('data-team-index');
                if (idx !== null) openTeamModal(parseInt(idx));
            });
        });
    }

    function openTeamModal(index) {
        const member = teamMembers[index];
        const modal = document.getElementById('globalModal');
        const modalTitle = document.getElementById('modalTitle');
        const modalBody = document.getElementById('modalBody');
        
        modalTitle.innerHTML = `<i class="fas fa-user-astronaut"></i> ${member.name} · ${member.role}`;
        modalBody.innerHTML = `
            <div style="text-align:center; margin-bottom:12px;">
                <div style="font-size:4rem;">${member.avatarIcon}</div>
            </div>
            <p><strong>📋 Tentang:</strong> ${member.fullBio}</p>
            <div class="contact-item"><i class="fas fa-envelope"></i> <strong>Email:</strong> <a href="mailto:${member.email}">${member.email}</a></div>
            <div class="social-links">
                <a href="${member.instagram}" target="_blank" class="social-link"><i class="fab fa-instagram"></i> Instagram</a>
                <a href="${member.linkedin}" target="_blank" class="social-link"><i class="fab fa-linkedin"></i> LinkedIn</a>
            </div>
            <p style="margin-top:18px;"><i class="fas fa-code"></i> "Berkolaborasi dalam keamanan siber dan infrastruktur jaringan"</p>
        `;
        modal.style.display = 'flex';
    }

    function renderGallery() {
        const galleryDiv = document.getElementById('galleryContainer');
        if (galleryDiv) {
            galleryDiv.innerHTML = galleryItems.map(item => `
                <div class="gallery-item">
                    <div class="gallery-img" style="background-image: url('${item.imgUrl}'); background-size: cover;"></div>
                    <div class="gallery-caption">
                        <h4><i class="fas fa-shield-alt"></i> ${item.title}</h4>
                        <p>${item.desc}</p>
                    </div>
                </div>
            `).join('');
        }
    }

    function renderTimeline() {
        const monthsGrid = document.getElementById('monthsTimeline');
        if (!monthsGrid) return;
        monthsGrid.innerHTML = monthlyLogs.map((month, idx) => `
            <div class="month-card" data-month-index="${idx}">
                <div class="month-header">
                    <span class="month-name">📅 ${month.monthPeriod}</span>
                    <span class="month-badge"><i class="fas fa-code-branch"></i> phase</span>
                </div>
                <div class="month-title"><i class="fas fa-network-wired"></i> ${month.title}</div>
                <div class="month-desc">${month.descContent}</div>
                <div class="tech-stack">
                    ${month.tags.map(tag => `<span class="tech-tag">#${tag}</span>`).join('')}
                </div>
                <div class="click-hint"><i class="fas fa-hand-pointer"></i> Klik untuk detail</div>
            </div>
        `).join('');

        document.querySelectorAll('.month-card').forEach(card => {
            card.addEventListener('click', () => {
                const idx = card.getAttribute('data-month-index');
                if (idx !== null) openMonthModal(parseInt(idx));
            });
        });
    }

    function openMonthModal(monthIndex) {
        const data = monthlyLogs[monthIndex];
        const modal = document.getElementById('globalModal');
        const modalTitle = document.getElementById('modalTitle');
        const modalBody = document.getElementById('modalBody');
        
        modalTitle.innerHTML = `<i class="fas fa-calendar-alt"></i> ${data.monthPeriod} · ${data.title}`;
        modalBody.innerHTML = `
            <img src="${data.image}" alt="Momen ${data.monthPeriod}" class="modal-img" onerror="this.src='https://picsum.photos/id/1/500/300'">
            <p><strong>📌 Penjelasan Lengkap:</strong> ${data.detailed}</p>
            <ul class="modal-detail-list">
                <li><i class="fas fa-microchip"></i> <strong>Tools:</strong> ${data.tags.join(', ')}</li>
                <li><i class="fas fa-chart-line"></i> <strong>Capaian:</strong> Tim berhasil menyelesaikan fase ini dengan outstanding.</li>
            </ul>
        `;
        modal.style.display = 'flex';
    }

    const modal = document.getElementById('globalModal');
    const closeBtn = document.getElementById('closeModalBtn');
    function closeModal() { modal.style.display = 'none'; }
    window.onclick = function(e) { if (e.target === modal) closeModal(); };
    closeBtn.onclick = closeModal;

    document.getElementById('backToTop')?.addEventListener('click', (e) => {
        e.preventDefault();
        window.scrollTo({ top: 0, behavior: 'smooth' });
    });

    renderTeam();
    renderGallery();
    renderTimeline();

    const observerElements = document.querySelectorAll('.team-card, .gallery-item, .month-card, .quote-block');
    const observer = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
            if (entry.isIntersecting) {
                entry.target.style.opacity = '1';
                entry.target.style.transform = 'translateY(0)';
                observer.unobserve(entry.target);
            }
        });
    }, { threshold: 0.1 });
    observerElements.forEach(el => {
        el.style.opacity = '0';
        el.style.transform = 'translateY(18px)';
        el.style.transition = 'opacity 0.5s ease, transform 0.4s ease';
        observer.observe(el);
    });
</script>
</body>
</html>
